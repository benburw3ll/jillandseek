{
  "name": "jillandseek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A lost-dog finder for Minnesota, run on the owner's own computer.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --parallel --filter @jillandseek/server --filter @jillandseek/web run dev",
    "start": "pnpm --filter @jillandseek/web run build && pnpm --filter @jillandseek/server run start",
    "check": "pnpm check:personal && pnpm typecheck && pnpm lint && pnpm sources:check && pnpm test && pnpm build",
    "check:personal": "node scripts/check-personal.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "sources:check": "pnpm --filter @jillandseek/sources run --if-present sources:check",
    "ai:check": "node apps/server/src/ai/check-main.ts",
    "eval:match": "pnpm --filter @jillandseek/core run --if-present eval:match",
    "test": "vitest run",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "26.6.11",
    "lefthook": "2.2.4",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
